# e-İslam RAG API (Spring Boot) — geliştirme makinesi IP + port
# Android emülatör: http://10.0.2.2:8080
# Fiziksel telefon (aynı Wi-Fi): http://192.168.x.x:8080
EXPO_PUBLIC_RAG_API_URL=http://192.168.0.30:8080

# ── RevenueCat (dashboard → Project → API keys → Public) ──
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=

# ── AdMob (admob.google.com → Uygulamalar → App ID) ──
# Boş bırakılırsa Google test App ID kullanılır (store build öncesi doldurun)
EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=
EXPO_PUBLIC_ADMOB_IOS_APP_ID=

# Banner reklam birimi (Reklam birimleri → Banner)
# Boş bırakılırsa geliştirmede test banner gösterilir
EXPO_PUBLIC_ADMOB_BANNER_ANDROID=
EXPO_PUBLIC_ADMOB_BANNER_IOS=
