# e-İslam RAG API (Spring Boot) — geliştirme makinesi IP + port
# Android emülatör: http://10.0.2.2:8080
# Fiziksel telefon (aynı Wi-Fi): http://192.168.x.x:8080
EXPO_PUBLIC_RAG_API_URL=http://192.168.0.30:8080

# ── RevenueCat (dashboard → Project → API keys → Public) ──
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=

# ── Google Sign-In (Cloud Console OAuth client ID) ──
# Web client ID id_token audience olarak da kullanılır (backend GOOGLE_OAUTH_CLIENT_IDS)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# ── AdMob (admob.google.com → Uygulamalar → App ID) ──
# Boş bırakılırsa Google test App ID kullanılır (store build öncesi doldurun)
EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=
EXPO_PUBLIC_ADMOB_IOS_APP_ID=

# Banner reklam birimi (Reklam birimleri → Banner)
# Boş bırakılırsa geliştirmede test banner gösterilir
EXPO_PUBLIC_ADMOB_BANNER_ANDROID=
EXPO_PUBLIC_ADMOB_BANNER_IOS=

# Interstitial (tam ekran) — quiz bitişi / sohbet çıkışı
EXPO_PUBLIC_ADMOB_INTERSTITIAL_ANDROID=
EXPO_PUBLIC_ADMOB_INTERSTITIAL_IOS=

# App Open — uygulama açılışı / arka plandan dönüş
EXPO_PUBLIC_ADMOB_APP_OPEN_ANDROID=
EXPO_PUBLIC_ADMOB_APP_OPEN_IOS=

# Kapalı testte test reklamı zorla (geçersiz tıklama riskini azaltır)
# EXPO_PUBLIC_ADMOB_FORCE_TEST_ADS=true
